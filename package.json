{
  "name": "@jenssimon/stylelint-config",
  "version": "0.0.0-development",
  "description": "A collection of shareable Stylelint configurations",
  "main": "index.js",
  "author": "Jens Simon <https://github.com/jenssimon>",
  "keywords": [
    "stylelint",
    "stylelintconfig"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jenssimon/stylelint-config"
  },
  "license": "MIT",
  "files": [
    "/index.js",
    "/base.js",
    "/base-order.js",
    "/order.js",
    "/sfra.js",
    "/lib"
  ],
  "scripts": {
    "lint": "eslint .",
    "commit": "cz",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "stylelint-config-recess-order": "^7.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0"
  },
  "peerDependencies": {
    "stylelint": ">=14.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.0",
    "@jenssimon/eslint-config-base": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.0",
    "eslint-config-airbnb-extended": "^2.3.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-esm": "^3.0.1",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.3.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "pinst": "^3.0.0",
    "semantic-release": "^25.0.0",
    "stylelint": "^16.0.0"
  },
  "packageManager": "yarn@4.10.3",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
